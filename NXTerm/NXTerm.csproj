<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\NXTerm.ico</ApplicationIcon>
    <!-- The RTSP viewer calls the Windows H.264 decoder through raw COM pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <Product>NXTerm</Product>
    <Description>Terminal emulator for Windows: Serial, SSH, Telnet</Description>
    <Copyright>Copyright (c) 2026 NXTerm contributors. MIT License.</Copyright>
    <!-- The release workflow sets these from the git tag and the repository name. -->
    <Version>1.3.0</Version>
    <GitHubRepo>KNOT-ARIGATO/NXTerm</GitHubRepo>
    <!-- "standalone" for the build that bundles the .NET runtime (see the release workflow); empty otherwise. -->
    <Flavor></Flavor>
  </PropertyGroup>

  <ItemGroup>
    <!-- "owner/repo" used by Help > Check for updates. -->
    <AssemblyMetadata Include="GitHubRepo" Value="$(GitHubRepo)" />
    <AssemblyMetadata Include="Flavor" Value="$(Flavor)" />
    <EmbeddedResource Include="Resources\NXTerm.ico" LogicalName="NXTerm.ico" />
    <!-- Shown by Help > Open-source licenses, so the notices travel inside NXTerm.exe. -->
    <EmbeddedResource Include="..\LICENSE" LogicalName="LICENSE.txt" Link="Resources\LICENSE.txt" />
    <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" Link="Resources\THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
